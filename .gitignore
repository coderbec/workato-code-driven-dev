# Secrets live in the WORKATO_CODE_DEV profile variable, never in files.
# Keep any stray .env out of git anyway.
.env
.env.*

# Generated by the guided setup from .mcp.template.json (machine-specific data centre URLs)
.mcp.json
.workato-labs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
!terraform/*.tfvars.example

# Build outputs
build/
dist/
*.zip

# Logs
logs/
*.log
npm-debug.log*

# Cache
.cache/
.vscode-test/

# OS
Thumbs.db
.DS_Store

# Workato
.workato/auth
recipes/.wk_cache
# Hydrated wk pull output (keep only the placeholder so the dir exists)
recipes/*
!recipes/.gitkeep

# Customer-specific Workato material must NEVER be committed, wherever it lands.
# Enforced by scripts/check-no-customer-assets.sh (pre-commit hook + CI), which
# also blocks `git add -f`.
.wk/
**/.wk/
wk.toml
packages/
*.recipe.json
*.connection.json
*.decision_engine_model.json
*.mcp_server.json
*.topic.json
*.workato_db_table.json
*.custom_adapter.*
*.agentic_*.json
*.agentic_genie.png

# Azure
.azure/

# Generated files
generated/
__pycache__/
*.pyc

# Local backups, caches and customer/internal working files (repo is public)
.workato/
