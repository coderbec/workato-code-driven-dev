// OpenCode Configuration - Workato Code-Driven Development
// Docs: https://opencode.ai/docs/config
// Skills in .agents/skills/<name>/SKILL.md are auto-discovered (no registration needed).
// Requires WORKATO_API_TOKEN (and optionally AIRO_API_TOKEN) in your shell environment.
{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "workato-developer-api": {
      "type": "remote",
      "url": "https://app.workato.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:WORKATO_API_TOKEN}"
      }
    },
    "workato-airo": {
      "type": "remote",
      "url": "https://app.workato.com/airo_mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:WORKATO_API_TOKEN}"
      }
    }
  }
}
